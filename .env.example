# Copy to .env and edit. Used by docker compose and the Makefile's docker targets.
# Every value is optional; leave blank for auto-detection.

# Address the dashboard listens on. 0.0.0.0 = reachable from other devices on the LAN.
NETWATCH_HOST=0.0.0.0

# Dashboard port.
NETWATCH_PORT=8008

# Interface to scan on (e.g. eth0, wlan0). Blank = auto, skipping VPN tunnels.
NETWATCH_IFACE=

# Range to sweep (e.g. 192.168.1.0/24). Blank = auto from the interface.
NETWATCH_SUBNET=

# Set to 1 for simulated devices.
NETWATCH_DEMO=
